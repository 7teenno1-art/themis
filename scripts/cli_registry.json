{
  "claude": {
    "enabled": false,
    "probe": ["claude", "auth", "status"],
    "invoke": ["claude", "-p"],
    "model": "claude-opus-5",
    "effort": "max",
    "data_classes": ["pd", "text", "public", "infra"]
  },
  "codex": {
    "probe": ["codex", "login", "status"],
    "invoke": ["codex", "exec", "--json", "--skip-git-repo-check", "--sandbox", "read-only", "-c", "approval_policy=\"never\""],
    "model": "gpt-5.6-sol",
    "effort": "high",
    "effort_args": ["-c", "model_reasoning_effort=\"{effort}\""],
    "response_format": "jsonl-events",
    "data_classes": ["text", "public", "infra"]
  },
  "kimi": {
    "enabled": false,
    "probe": ["kimi", "--version"],
    "invoke": ["kimi", "-p"],
    "model": "kimi-k2.5",
    "effort": "max",
    "data_classes": ["text", "public", "infra"]
  },
  "gemini": {
    "enabled": false,
    "probe": ["gemini", "--version"],
    "invoke": ["gemini", "-p"],
    "model": "gemini-2.5-pro",
    "effort": "max",
    "data_classes": ["text", "public", "infra"]
  }
}
