# Периметр графа прибора. Семантика gitignore, last-match-wins (graphify/detect.py).
#
# Замер 03.09.2026: без этого файла движок обошел все дерево и собрал в один
# индекс 3278 узлов из cases/ по 73 доверителям, 5446 записей о файлах дел в
# manifest.json (в том числе 3551 JPG и 69 MP4 из 00_intake) и 22,8 МБ
# сконвертированного текста документов в converted/. Спросив такой граф по делу
# одного доверителя, можно вытащить узлы дела другого.

# Материалы дел. Периметр адвокатской тайны: у каждого дела свой граф в
# cases/{клиент}/{дело}/.agent/graph/, общий индекс их не смешивает.
cases/

# Корпус права и знания дома — отдельный граф (knowledge/graphify-out/): у него
# свое событие пересборки и своя политика свежести. Плюс замер: practice_index.md
# и LAST_UPDATED.md несут имена папок дел в поле источника, поэтому в общий
# индекс они не идут до отдельного решения по этому полю.
knowledge/*
# Код в knowledge/ фактуры доверителей не несет: это сборщики образцов и
# верстка. Он остается в графе, чтобы агент чужого клона видел дом целиком.
!knowledge/legal-design/
# Сами образцы-документы в граф не идут: движок кладет их конвертацию в
# graphify-out/converted/, а тот каталог с домом не едет, и граф начинает
# ссылаться на файлы, которых у читателя нет. Код образцов остается.
knowledge/legal-design/**/*.docx
knowledge/legal-design/**/*.pdf
knowledge/legal-design/**/*.xlsx

# Свой же вывод: в прошлом прогоне граф проиндексировал сам себя на 1375 узлов.
graphify-out/

# Бэкапы приборов режима обслуживания. В дом они не едут (.gitignore), и граф,
# который на них ссылается, у читателя показывает пустоту.
docs/remont/bak-*/
